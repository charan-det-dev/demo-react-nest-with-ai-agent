# --- Database (Prisma / PostgreSQL, see ADR-0002) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app?schema=public

# --- Auth (JWT Bearer token, see ADR-0001) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=15m

# --- Token expiry (email verification / password reset) ---
VERIFICATION_TOKEN_EXPIRES_IN=24h
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# --- Mail (MailHog SMTP in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="No Reply <no-reply@example.com>"

# --- App ---
PORT=3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
